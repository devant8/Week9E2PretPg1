:root[data-theme="dark"]{
  --paper:#0b1220; --card:#141e31; --ink:#e7ecf5; --muted:#9aa7bf; --line:#27344d;
  --board:#060c18; --board-ink:#aab6cc; --led:#ffbf3d; --gold:#e0b04a; --gold-soft:#3a2f14;
  --ok:#5fd093; --ok-soft:#123426; --miss:#ff8a80; --miss-soft:#3c1a19; --hint-soft:#1b2944; color-scheme:dark}

body{background:var(--paper);color:var(--ink);font-family:var(--f-ui);font-size:16px;line-height:1.5}
.wrap{max-width:780px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}

/* Scoreboard */
.board{background:var(--board);color:var(--board-ink);border-bottom:4px solid var(--gold)}
.board .wrap{padding-block:14px 16px;display:grid;grid-template-columns:1fr auto 1fr;align-items:end;gap:12px}
.board h1{grid-column:1/-1;margin:0;font-family:var(--f-display);font-weight:800;font-size:clamp(1.05rem,3.6vw,1.4rem);letter-spacing:.14em;text-transform:uppercase;text-align:center;color:#fff;text-wrap:balance}
